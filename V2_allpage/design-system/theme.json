{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1136px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        { "slug": "primary", "name": "品牌深藍 Primary", "color": "#143A82" },
        { "slug": "accent", "name": "強調藍 Accent", "color": "#1F5BB5" },
        { "slug": "interactive", "name": "互動藍 Interactive", "color": "#2E72D6" },
        { "slug": "blue-200", "name": "淺藍（選取）", "color": "#AFC9EE" },
        { "slug": "blue-50", "name": "淺藍底", "color": "#F5F8FC" },
        { "slug": "ink-950", "name": "頁尾深藍", "color": "#091428" },
        { "slug": "ink-800", "name": "深色區塊", "color": "#0E1C3D" },
        { "slug": "title", "name": "標題文字", "color": "#1C2533" },
        { "slug": "text", "name": "內文", "color": "#5A6473" },
        { "slug": "muted", "name": "輔助文字", "color": "#8893A8" },
        { "slug": "border", "name": "框線", "color": "#E5E8EC" },
        { "slug": "bg-alt", "name": "淺灰區塊底", "color": "#F4F6F9" },
        { "slug": "white", "name": "白", "color": "#FFFFFF" },
        { "slug": "success", "name": "認證綠", "color": "#2B8A4D" }
      ],
      "gradients": [
        { "slug": "hero-blue", "name": "Hero 深藍漸層", "gradient": "linear-gradient(120deg,#0E1C3D 0%,#143A82 70%)" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Noto Sans TC",
          "fontFamily": "'Noto Sans TC','PingFang TC','Microsoft JhengHei',sans-serif"
        },
        {
          "slug": "en",
          "name": "Manrope",
          "fontFamily": "'Manrope','Noto Sans TC',sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "caption", "name": "註記 12", "size": "12px" },
        { "slug": "sm", "name": "小字 13.5", "size": "13.5px" },
        { "slug": "body-sm", "name": "次要內文 14", "size": "14px" },
        { "slug": "body", "name": "內文 15", "size": "15px" },
        { "slug": "lead", "name": "導言 16", "size": "16px" },
        { "slug": "h5", "name": "H5 18", "size": "18px" },
        { "slug": "h4", "name": "H4 22", "size": "clamp(20px, 1.2vw + 15px, 22px)" },
        { "slug": "h3", "name": "H3 26", "size": "clamp(22px, 1vw + 18px, 26px)" },
        { "slug": "h2", "name": "H2 34", "size": "clamp(26px, 1.6vw + 16px, 34px)" },
        { "slug": "h1", "name": "H1 40", "size": "clamp(28px, 2.4vw + 12px, 40px)" },
        { "slug": "display", "name": "數據 46", "size": "clamp(34px, 2vw + 22px, 46px)" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "4", "size": "4px" },
        { "slug": "20", "name": "8", "size": "8px" },
        { "slug": "30", "name": "12", "size": "12px" },
        { "slug": "40", "name": "16", "size": "16px" },
        { "slug": "50", "name": "20", "size": "20px" },
        { "slug": "60", "name": "24", "size": "24px" },
        { "slug": "70", "name": "32", "size": "32px" },
        { "slug": "80", "name": "40", "size": "40px" },
        { "slug": "90", "name": "56", "size": "56px" },
        { "slug": "100", "name": "72", "size": "72px" },
        { "slug": "110", "name": "區塊留白 40–88", "size": "clamp(40px, 6vw, 88px)" }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "card-hover", "name": "卡片浮起", "shadow": "0 18px 40px -22px rgba(20,58,130,.35)" },
        { "slug": "media", "name": "配圖", "shadow": "0 30px 60px -34px rgba(20,58,130,.5)" },
        { "slug": "sm", "name": "淺陰影", "shadow": "0 8px 24px -22px rgba(20,58,130,.3)" }
      ]
    },
    "custom": {
      "radius": { "sm": "10px", "md": "16px", "lg": "24px", "pill": "999px", "hero": "90px" },
      "lineHeight": { "tight": "1.2", "heading": "1.35", "snug": "1.6", "body": "1.8" },
      "letterSpacing": { "eyebrow": ".16em", "label": ".04em", "display": "-.02em" }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--text)"
    },
    "spacing": {
      "padding": { "left": "clamp(16px, 4vw, 32px)", "right": "clamp(16px, 4vw, 32px)" },
      "blockGap": "var(--wp--preset--spacing--60)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.8"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "fontWeight": "800", "lineHeight": "1.35" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)", "lineHeight": "1.2" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)" } },
      "h4": { "color": { "text": "var(--wp--preset--color--title)" }, "typography": { "fontSize": "var(--wp--preset--font-size--h4)", "fontWeight": "700" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--h5)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "textDecoration": "none" },
        ":hover": { "color": { "text": "var(--wp--preset--color--interactive)" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--white)" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "10px", "bottom": "10px", "left": "24px", "right": "24px" } },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "700" },
        ":hover": { "shadow": "0 14px 26px -14px rgba(20,58,130,.6)" }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--caption)" }
      }
    },
    "blocks": {
      "core/image": { "border": { "radius": "24px" } },
      "core/separator": { "color": { "text": "var(--wp--preset--color--border)" } },
      "core/quote": {
        "border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "4px" } },
        "spacing": { "padding": { "left": "20px" } }
      }
    }
  }
}
